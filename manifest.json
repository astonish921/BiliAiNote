{
  "manifest_version": 3,
  "name": "BiliAiNote",
  "version": "1.1.1",
  "description": "B站视频字幕笔记工具 — 字幕识别+LLM总结+视频下载",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://api.bilibili.com/*",
    "https://*.bilibili.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://localhost/*",
    "https://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "*://*.bilibili.com/video/*",
        "*://*.bilibili.com/list/*"
      ],
      "js": ["libs/jszip.min.js", "libs/cropper.min.js", "libs/markdown-it.min.js", "js/state.js", "js/cache.js", "js/panel.js", "js/subtitle.js", "js/chapter.js", "js/video-info.js", "js/video-download.js", "js/capture.js", "js/export.js", "js/settings.js", "js/crop-viewer.js", "js/llm-doc.js", "js/ai-summary.js", "content.js"],
      "css": ["libs/cropper.min.css", "css/panel.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "BiliAiNote",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "CHANGELOG.md"],
      "matches": ["*://*.bilibili.com/*"]
    }
  ]
}
